package app

func scale(replay v Float) Float {
    return v * 2.0
}

// EXPECT: reject computed=approx demanded=replay
// EXPECT-KERNEL: fold_free
// EXPECT-NO-KERNEL: fold_replay
func main() Float {
    x := indices(count: 1000.0)
    return scale(sum(x)) + sum(x)
}
