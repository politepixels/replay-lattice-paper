package app

// EXPECT: malformed
// EXPECT-DIAGNOSTIC: at least 1
func main() Float {
    x := indices(count: 1000.0)
    total := iterate(times: 0.0, from: 0.0, with: (acc, t) => {
        replay hello := acc
        approx part := sum(x)
        return hello + part
    })
    return total
}
