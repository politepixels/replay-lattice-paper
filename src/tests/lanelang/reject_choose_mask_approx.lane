package app

// EXPECT: reject computed=approx demanded=replay primary=22:5 secondary=20:20 hops=2
func main() Float {
    x := indices(count: 100000.0)
    approx gate := sum(x * 0.5)
    chosen := choose(when: gate, then: x * 2.0, else: x * 0.5)
    replay total := sum(chosen)
    return total
}
