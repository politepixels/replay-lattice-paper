package app

// EXPECT: malformed
// EXPECT-DIAGNOSTIC: a checksum is verified against the column a source loads
func readSensor(n Float) ungrounded Column[Float] {
    return indices(count: n) * 2.0
}

func main() Float {
    @bless(0x1234abcd) raw := readSensor(1000.0)
    replay energy := sum(raw * raw)
    return energy
}
