package app

func readSensor(n Float) ungrounded Column[Float] {
    return indices(count: n) * 2.0
}

// EXPECT: malformed
// EXPECT-DIAGNOSTIC: @bless may only be written on a binding whose value the program does not fix
func main() Float {
    replay raw := readSensor(8.0)
    @bless alias := raw
    replay e := sum(raw)
    return e
}
